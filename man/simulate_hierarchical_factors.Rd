  lower_loadings = 0.55, lower_cross_loadings = 0.05,
  lower_correlations = 0.40, # target correlation of 0.40 between all lower-order factors
  higher_factors = 2, higher_loadings = 0.60,
  higher_cross_loadings = 0.05,
  sample_size = 1000
)

